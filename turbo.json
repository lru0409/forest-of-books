{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "NEXT_PUBLIC_API_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "API_PORT",
        "API_FRONTEND_URL",
        "API_JWT_SECRET",
        "API_NAVER_CLIENT_ID",
        "API_NAVER_CLIENT_SECRET",
        "API_NAVER_CALLBACK_URL",
        "API_KAKAO_CLIENT_ID",
        "API_KAKAO_CLIENT_SECRET",
        "API_KAKAO_CALLBACK_URL",
        "API_GOOGLE_CLIENT_ID",
        "API_GOOGLE_CLIENT_SECRET",
        "API_GOOGLE_CALLBACK_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    }
  }
}
